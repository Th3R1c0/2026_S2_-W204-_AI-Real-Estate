    "db:sync-flood-data": "node --env-file=.env.local --import=tsx scripts/sync-flood-data.ts",
    "db:sync-school-data": "node --env-file=.env.local --import=tsx scripts/sync-school-data.ts",
    "db:sync-school-data-file": "node --env-file=.env.local --import=tsx scripts/sync-school-data-file.ts",
    "db:export-school-data-sql": "node --import=tsx scripts/sync-school-data-file.ts"
  },
  "dependencies": {
    "@shadcn/react": "^0.3.1",
    "@typesafe-ai/sdk": "^0.7.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.59.0",
    "next": "16.3.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^26.1.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
