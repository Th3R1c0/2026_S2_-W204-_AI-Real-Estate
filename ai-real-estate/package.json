{
  "name": "ai-real-estate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup-local": "node scripts/setup-local-db.mjs",
    "db:generate": "drizzle-kit generate",
